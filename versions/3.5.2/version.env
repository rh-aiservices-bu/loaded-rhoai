# loaded-rhoai release pin: RHOAI 3.5.2.
# Everything here was installed and run together on the 3.5.2 spike cluster (OCP 4.22.18, AWS,
# 2026-11-05 to 2026-11-10). See lock.txt for the exact CSVs that were running.

RHOAI_VERSION=3.5.2
RHOAI_CHANNEL=stable-3.5
RHOAI_CSV=rhods-operator.3.5.2
MIN_OCP=4.19.9
WORKBENCH_IMAGE_TAG=3.5          # ImageStream tag the workbench images are taken from

# rhoai-maas-guide supplies MaaS, observability and Keycloak (PLAN.md §2, §7).
# eb0e79c is on GitHub main; its scripts/ and manifests/ are identical to what the spike ran.
GUIDE_REPO=https://github.com/rh-aiservices-bu/rhoai-maas-guide.git
GUIDE_REF=eb0e79c349c9537319fc2e8d3be78888af3d3bd7
RHBK_CHANNEL=stable-v26.4        # the guide's pin; RHBK CRDs are cluster-scoped, so any existing RHBK must match

# maaspal (PLAN.md §11). Installed headless: not registered with the dashboard (see README).
MAASPAL_CHART=oci://quay.io/rh-ai-community-plugins/maaspal-chart
MAASPAL_VERSION=1.0.0

LOADGEN_IMAGE=registry.access.redhat.com/ubi9/python-312@sha256:03eb6c797d3023bfa218aea6c5a1db130e2d1766ef9a1f082d5285b88aaa25f7

# Memory limits measured at ~355 projects (PLAN.md §4 controllerResources). Defaults OOMKilled.
CONTROLLER_LIMITS="ai-gateway-operator:2Gi dashboard-operator:2Gi kserve-module-controller-manager:3Gi kuberay-operator:2Gi llm-d-batch-gateway-operator:2Gi maas-controller:2Gi opendatahub-feast-operator:2Gi spark-operator-controller:2Gi trustyai-service-operator-controller-manager:2Gi"
RHCL_MEMORY_LIMIT=3Gi
RHCL_AUTH_SERVICE_TIMEOUT=2s     # guide Issue 7; maaspal load_test went from 55.7% errors to 0%

# Minimum worker root disk for medium and above. 100 GB filled to zero and evicted 69 pods.
MIN_WORKER_DISK_GI=240
